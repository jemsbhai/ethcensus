# Copy to .env and fill in. Never commit .env.
# OpenAlex: free key from https://openalex.org/settings/api (raises the daily budget from a shared $0.10 to $1 per key)
OPENALEX_API_KEY=
# Contact address sent in the User-Agent of every full-text request (arXiv asks crawlers to identify themselves)
CONTACT_EMAIL=
# Semantic Scholar Graph API key (request form linked from https://www.semanticscholar.org/product/api)
S2_API_KEY=
# Ollama cloud: models are called directly at https://ollama.com/api/chat with the account key (no local server).
OLLAMA_HOST=https://ollama.com
OLLAMA_API_KEY=
